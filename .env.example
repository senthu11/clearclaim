# Copy to .env, or keep your existing keys in .local-config/.env.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Choose a text/chat model available to your account using the app's model list.
NEBIUS_MODEL=
# Optional: the existing KEENABLE variable is also accepted.
KEENABLE_API_KEY=
# Optional: full path to tesseract.exe if it is not on PATH.
TESSERACT_CMD=
